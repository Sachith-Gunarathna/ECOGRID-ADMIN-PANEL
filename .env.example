SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM=EcoGrid <noreply@ecogrid.lk>

# ── CORS ─────────────────────────────────────────────────────
# Where the admin panel HTML is served from
FRONTEND_URL=http://localhost:3000
